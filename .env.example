# MD Compass environment variables.
# Copy this file to .env.local and fill in values. Never commit .env.local.
# Both are optional and read at build time.

# Region for emergency wording (lib/config.ts). Unset = "default".
# MDC_REGION=default

# Set to "true" to include draft condition pages in a production build.
# Only the end-to-end tests use this. Never set it for the live site.
# MDC_INCLUDE_DRAFTS=false
